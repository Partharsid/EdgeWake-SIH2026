yarn-error.log

# Build outputs
build/
dist/
.next/
out/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# IDE
.idea/
*.swp
*.swo

# Firebase
.firebase/
firebase-debug.log

# Large files
*.mp4
*.avi
*.wav
*.mp3
